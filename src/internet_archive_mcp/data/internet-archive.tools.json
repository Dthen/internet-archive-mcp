  {
    "name": "wayback_fetch",
    "description": "Fetch archived page content from the Wayback Machine.\n\nRetrieves the actual HTML/text content of an archived page. By default\nfetches raw content (no Wayback toolbar injection). Content is truncated\nto char_limit characters.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "The original URL to fetch from the archive."
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wayback timestamp (e.g. \"20200101120000\"). If omitted,\nfetches the most recent snapshot."
        },
        "raw": {
          "default": true,
          "type": "boolean",
          "description": "If True (default), fetch raw content without the Wayback\nMachine toolbar. Appends \"id_\" to the timestamp."
        },
        "char_limit": {
          "default": 50000,
          "type": "integer",
          "description": "Maximum characters to return (default 50000). Content\nbeyond this limit is truncated."
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
  {
