[
  {
    "name": "search_archive",
    "description": "Search the Internet Archive catalog using the advanced search API.\n\nReturns paginated results with item identifiers, titles, creators, and\ndownload counts. Supports filtering by media type and collection.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "description": "Free-text Lucene query (e.g. \"jazz piano\", \"creator:ellis\")."
        },
        "mediatype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filter by media type (texts, web, movies, audio, data, image, collection, software)."
        },
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict results to a specific collection identifier."
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Metadata fields to return per result. Defaults to identifier,\ntitle, mediatype, creator, downloads, publicdate, year."
        },
        "sort": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to 3 sort expressions (e.g. [\"downloads desc\", \"year asc\"])."
        },
        "rows": {
          "default": 20,
          "type": "integer",
          "description": "Number of results per page (default 20)."
        },
        "page": {
          "default": 1,
          "type": "integer",
          "description": "Page number, 1-indexed (default 1)."
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
