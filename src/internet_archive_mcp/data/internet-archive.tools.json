  {
    "name": "wayback_snapshots",
    "description": "Search the Wayback Machine CDX index for snapshots of a URL.\n\nReturns a list of snapshot records with timestamp, original URL, MIME\ntype, status code, and digest. Use match_type to control URL matching.\n\nWhen show_resume_key is True, returns a dict with \"snapshots\" and\n\"resume_key\" keys for paging through large result sets.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL to search for (e.g. \"example.com/page\")."
        },
        "match_type": {
          "default": "exact",
          "type": "string",
          "description": "One of \"exact\", \"prefix\", \"host\", or \"domain\".\nNote: \"domain\" requires authentication and will return an error."
        },
        "from_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only include snapshots from this year onward."
        },
        "to_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only include snapshots up to this year."
        },
        "limit": {
          "default": 25,
          "type": "integer",
          "description": "Maximum number of results (default 25)."
        },
        "filter_expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CDX filter expression(s), e.g. \"statuscode:200\" or\n[\"mimetype:text/html\", \"statuscode:200\"]."
        },
        "collapse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Collapse results by a field, e.g. \"urlkey\" or\n\"timestamp:4\" (group by year)."
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CDX fields to return (e.g. [\"timestamp\", \"original\",\n\"statuscode\"]). Defaults to all fields."
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Result page number (pairs with limit for pagination)."
        },
        "show_resume_key": {
          "default": false,
          "type": "boolean",
          "description": "When True, response includes a resume key for\ncontinuing pagination. Returns a dict instead of a list."
        },
        "resume_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pass a resume key from a previous response to continue\nfrom where it left off."
        },
        "newest": {
          "default": false,
          "type": "boolean",
          "description": "When True, return the newest snapshot first."
        },
        "fast_latest": {
          "default": false,
          "type": "boolean",
          "description": "When True, use a faster algorithm for latest snapshots."
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
  {
    "name": "wayback_availability",
    "description": "Check if a URL has an archived snapshot in the Wayback Machine.\n\nQuick single-snapshot check — returns the closest available snapshot\ntimestamp and URL. Good for \"is this archived?\" questions.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL to check (e.g. \"https://example.com\")."
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
