  {
    "name": "search_archive_deep",
    "description": "Deep search using the Internet Archive scraping API with cursor paging.\n\nUnlike search_archive (limited to 1000 pages), this supports unlimited\npagination via cursors. Minimum count is 100 per request.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "description": "Lucene search query string."
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of metadata fields to return (e.g. [\"identifier\", \"title\"])."
        },
        "sorts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sort expressions (e.g. [\"downloads desc\"])."
        },
        "count": {
          "default": 100,
          "type": "integer",
          "description": "Results per page, minimum 100 (default 100)."
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque cursor string from a previous response for the\nnext page. Omit for the first page."
        },
        "total_only": {
          "default": false,
          "type": "boolean",
          "description": "When True, return only the total count without item\nrecords. Useful for quick cardinality checks."
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
