    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL to archive."
        },
        "access_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IA S3 access key. Falls back to IA_ACCESS_KEY env var."
        },
        "secret_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IA S3 secret key. Falls back to IA_SECRET_KEY env var."
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
