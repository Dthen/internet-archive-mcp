          "description": "Page number, 1-indexed (default 1)."
        },
        "sort": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sort expressions. Defaults to [\"downloads desc\"]."
